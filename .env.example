# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible provider works (Groq, OpenRouter, Gemini OpenAI endpoint, Ollama).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Leave model lines empty to use the defaults in config/settings.yaml.
EXTRACT_MODEL=
EXPLAIN_MODEL=
AGENT_MODEL=
# Judge must be a different model family from EXPLAIN_MODEL. Optional separate provider:
JUDGE_MODEL=
PROFILE_MODEL=
# Gemini (OpenAI-compatible endpoint) is used for job extraction.
GEMINI_API_KEY=
JUDGE_API_KEY=
JUDGE_BASE_URL=
# Docker Compose overrides this to point at the db service.
# Host access to the Compose db (mapped to 5433). Inside Compose the api uses db:5432.
DATABASE_URL=postgresql+psycopg://joblens:joblens@localhost:5433/joblens
# Admin routes stay closed until this is a real key (12+ characters; placeholders like change-me are refused).
ADMIN_API_KEY=change-me
# Demo rate limits for chat/paste/explain/resume (config/settings.yaml `limits`); false turns them off.
DEMO_LIMITS=true
# Set LLM_PROVIDER=fake to force the offline fake client (heuristic extractor).
LLM_PROVIDER=auto
